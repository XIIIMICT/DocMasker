{
  "uid": "docmasker-cache",
  "title": "DocMasker — Кэш",
  "tags": ["docmasker", "cache"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Hit ratio (окно 5m)",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "docmasker-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(dm_cache_operations_total{operation=\"hit\",outcome=\"ok\"}[5m])) / clamp_min(sum(rate(dm_cache_operations_total{outcome=\"ok\"}[5m])), 1)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.5 },
              { "color": "green", "value": 0.8 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["last"] } }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Операции кэша (hit/miss/write/failure/eviction)",
      "gridPos": { "h": 9, "w": 16, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "docmasker-prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (operation, outcome) (rate(dm_cache_operations_total[5m]))", "legendFormat": "{{operation}}/{{outcome}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "fillOpacity": 15 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Отказы кэша",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "docmasker-prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (operation) (rate(dm_cache_operations_total{operation=\"failure\"}[5m]))", "legendFormat": "{{operation}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "bars", "fillOpacity": 50 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Пул PostgreSQL: занято / ёмкость",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "docmasker-prometheus" },
      "targets": [
        { "refId": "A", "expr": "dm_db_connections_in_use", "legendFormat": "in use" },
        { "refId": "B", "expr": "dm_db_pool_capacity", "legendFormat": "capacity" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    }
  ]
}
