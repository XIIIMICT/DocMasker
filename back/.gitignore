# Deny-all by default (see root .gitignore): whitelist below.
# .venv/, __pycache__, caches, logs, local HF model cache stay out.

*
!/.dockerignore
!/.gitignore
!AGENTS.md
!Dockerfile
!alembic.ini
!prek.toml
!pyproject.toml
!uv.lock

!/config/
!/config/**

# Source, migrations and tests
!/src/
!/src/**
!/tests/
!/tests/**
!/migrations/
!/migrations/**
!/benchmarks/
!/benchmarks/**

# Junk inside the whitelist (last rule wins)
__pycache__/
*.py[cod]
.venv/
.ruff_cache/
.pytest_cache/
# Private runtime exception data must never be committed.
config/masking/exceptions.yaml
