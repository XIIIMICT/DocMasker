# DocMasker — единственный шаблон конфигурации.
# • Docker-стек и justfile читают корневой .env: cp .env.example .env.
#
# Всё окружение задаётся один раз здесь и распространяется в
# compose.yaml (проброс портов, healthcheck, внутренние URL) и в Dockerfiles.

# ─── Порты бэкенда и фронтенда (обязательные, единая точка) ──────────────────
# Значения задают compose: проброс портов, healthcheck, внутренний URL и ARG
# в Dockerfile. Имя сервиса бэкенда в compose-сети — BACKEND_HOST.
# Внимание: 5000/8000 из референса ReportCollector заняты другим проектом,
# поэтому здесь 5001 (фронт) и 8001 (бэк).
BACKEND_PORT=8001
FRONT_PORT=5001
BACKEND_HOST=back
BACKEND_HOST_DEV=back-dev

# ─── URL фронтенда для CORS-ориджинов ────────────────────────────────────────
# Фронт проксирует /api/* на бэк server-side, поэтому браузер ходит только на
# один origin; BACKEND_CORS_ORIGINS нужен только для прямых запросов в dev
# (напр. curl/инструменты). Бэкенд по умолчанию разрешает localhost-ориджины.
# AUTH_APP_ORIGIN зеркалирует исходный .env референса ReportCollector и
# задаёт публичный адрес приложения.
AUTH_APP_ORIGIN=http://127.0.0.1:5001

# ─── Маскирование (детерминированный пайплайн) ───────────────────────────────
# Пайплайн правила-based: natasha (морфология/ФИО/адреса) + phonenumbers
# (телефоны) + регулярки (email, юр. префиксы). Никаких моделей и загрузок —
# бэкенд стартует мгновенно.
# Типы сущностей задаются профилями маскирования (см. GET /api/profiles и
# docs/adr/0001-masking-profiles.md). Переменная MASK_LABELS удалена — её
# наличие в окружении теперь ошибка старта бэкенда.

# ─── Лимиты ресурсов API ─────────────────────────────────────────────────────
# UPLOAD_MAX_MB — максимум для загружаемого .docx (валидация OPC/ZIP-структуры,
# лимит записей и защита от архив-бомб идут поверх этого лимита).
# MAX_TEXT_CHARS / MAX_KEYS_CHARS — лимиты текста и ключей в JSON-запросах.
# Превышения отвечают 413 с русским detail; фронт не является границей доверия.
UPLOAD_MAX_MB=25
MAX_TEXT_CHARS=200000
MAX_KEYS_CHARS=1000000

# ─── Длительные задачи (ADR-0002 / PostgreSQL-основа ADR-0003) ──────────────
# PostgreSQL — авторитетный источник состояния заданий; SQLite удалён.
# ARTIFACTS: приватный volume JOBS_DIR (входы/результаты по непредсказуемому
# job_id, PII в БД не попадает). Valkey — disposable cache index (логика — этап 3).
# Пароли ниже — очевидные плейсхолдеры; прод-запуск требует своих значений.
POSTGRES_USER=dm
POSTGRES_PASSWORD=change-me
POSTGRES_DB=docmasker
# ReportCollector pattern: POSTGRES_HOST is for host-side scripts (just seed,
# migrations, local backend); compose overrides it with POSTGRES_HOST_DOCKER
# (the compose service name) via the x-db-env anchor. No need to rewrite .env.
POSTGRES_HOST=localhost
POSTGRES_HOST_DOCKER=postgres
# Host-side access port for `just db-stand` + `just seed`. 5432 is commonly
# taken by other projects (ReportCollector); only loopback is published.
POSTGRES_PORT=15433
# Optional explicit override (CI uses it); normally the URL is built from the
# POSTGRES_* components above. Do not set it in .env for the local stack.
# DATABASE_URL=postgresql+psycopg://dm:change-me@localhost:15433/docmasker
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_CONNECT_TIMEOUT_SECONDS=5
VALKEY_URL=redis://:change-me@valkey:6379/0
VALKEY_PASSWORD=change-me
CACHE_ENABLED=true
CACHE_TTL_SECONDS=86400
CACHE_NAMESPACE_VERSION=1
# Стабильный HMAC-секрет (не менее 16 символов); смена инвалидирует весь кэш.
CACHE_KEY_SECRET=change-me-stable-cache-secret
CACHE_CONNECT_TIMEOUT_SECONDS=2
CACHE_SOCKET_TIMEOUT_SECONDS=2
CACHE_MAX_ENTRIES=100000
CACHE_MAX_MEMORY_MB=256
# Бампать при изменении semantics/контракта результата (инвалидация кэша).
MASKING_RULESET_VERSION=1
RESULT_MANIFEST_VERSION=1
MASKING_CONFIG_DIGEST=auto
MASKING_CONFIG_DIR=/app/config/masking
KEYS_FORMAT_VERSION=1
DOCX_TRANSFORMER_VERSION=2
STAGING_LEASE_SECONDS=60
JOBS_DIR=/app/jobs
# Минимально свободное место на томе артефактов перед приёмом задания и стартом
# воркера (по умолчанию 1 GiB). На маленьких томах можно снизить явно.
JOBS_MIN_FREE_BYTES=1073741824
SYNC_MAX_TEXT_CHARS=20000
SYNC_MAX_DOCX_BYTES=1048576
SYNC_MAX_DOCX_PARAGRAPHS=200
# Ограничения очереди и воркера (тёплый пул потоков, по одному masker на поток).
# JOBS_CONCURRENCY=4 выбран по измеренному RSS: 431 MB пик процесса при 4 потоках,
# консервативная доля на поток 159 MB, бюджет 1 GiB, запас 1.5 (см. docs/PERFORMANCE.md).
# JOBS_MAX_ACTIVE=32 = 2 x измеренный всплеск из 16 заявок, принятых до первого claim.
# JOBS_RETRY_AFTER_SECONDS=45 — ожидаемое время дренажа очереди при p95 6.2 c/док.
# При изменении этих значений обновите алерты и панель «Рабочая очередь».
JOBS_MAX_ACTIVE=32
JOBS_CONCURRENCY=4
JOBS_RETRY_AFTER_SECONDS=45
JOBS_MAX_ATTEMPTS=3
JOBS_LEASE_SECONDS=30
JOBS_POLL_SECONDS=1
JOBS_TTL_SECONDS=3600

# ─── Обратная связь: «Связаться с разработчиком» ────────────────────────────
# Почта письма из кнопки в правом краю шапки (тема «Обращение по ДокМаскер»).
# Значение читается только на сервере (page.tsx) и не попадает в клиентский
# бандл. Пусто — кнопка не показывается.
# SUPPORT_MAIL=support@example.ru

# ─── Наблюдательный стек (мониторинг) ────────────────────────────────────────
# Две формы существования стека, как у PostgreSQL/Valkey:
#  1) локальный стенд (`just monitoring-stand`): все сервисы в этом compose,
#     адреса — имена сервисов (loki, prometheus, back, worker);
#  2) внешний/центральный DWH: поднимается только Alloy (`just monitoring`),
#     адреса переопределяются в .env, например
#     LOKI_URL=http://host.docker.internal:3100 или https://loki.<сервер>.
# Приложение НЕ пишет в Loki напрямую — только Alloy читает ./logs/*.log.

# Адрес Loki, доступный из контейнера Alloy и Grafana. Обязательный (:? в compose).
# Локально: http://loki:3100; на сервере с центральным стеком — внешний адрес.
LOKI_URL=http://loki:3100
# Лейбл env на всех логах: local для локального стека, prod — на сервере.
LOG_ENV=local

# Локальная Grafana (`just monitoring-stand`). Обязательные (:? в compose).
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me

# Хранилище метрик/логов: 15 дней сырых сэмплов при скрапе раз в 15 с и 7 дней
# логов. Значения можно увеличить, но следите за размером томов dm-*-data.
PROMETHEUS_RETENTION=15d
LOKI_RETENTION=168h

# Prometheus не раскрывает ${VAR} в конфиге: infra/prometheus/entrypoint.sh
# рендерит цели старта из этих переменных. Локальный дефолт — имена сервисов
# этого compose (контейнеры слушают 0.0.0.0 внутри сети dm-net, хотя на хост
# порты опубликованы только на loopback). Внешний/центральный режим — переопределите
# на host.docker.internal или адрес центрального стека.
BACKEND_METRICS_HOST=back
WORKER_METRICS_HOST=worker
# Метрики воркера — долгоживущий процесс, его скрапит Prometheus (без Pushgateway).
WORKER_METRICS_PORT=8002
# В DocMasker Pushgateway НЕ используется: это не пакетный CLI. Переменная
# оставлена для единого контракта с другими репозиториями и должна быть пустой.
METRICS_PUSHGATEWAY_URL=

# Почта алертов. Alertmanager рендерит эти значения при старте контейнера —
# после правки перезапустите стек (`just monitoring-stand`).
# Внутренний переход Alertmanager -> свой SMTP-релей идёт по простому SMTP:25
# (smtp_require_tls: false), а релей -> корпоративный SMTP — по STARTTLS:587
# с учётными данными SMTP_RELAY_* ниже. Это задокументированное отклонение.
# Порт 465 (неявный TLS) с smtp_require_tls несовместим.
SUPPORT_MAIL=support@example.ru
ALERT_SMTP_FROM=docmasker@example.ru
ALERT_SMTP_SMARTHOST=smtp-relay:25
# Пустые логин/пароль = релей не требует аутентификации из внутренней сети;
# entrypoint.sh тогда удаляет строки auth_* из сгенерированного конфига.
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=

# Сам релей (juanluisbaptiste/postfix) отправляет в корпоративный SMTP через
# STARTTLS:587 с учётными данными ниже. SERVER_HOSTNAME — имя, которым релей
# представляется в SMTP-диалоге.
SMTP_RELAY_SERVER=
SMTP_RELAY_PORT=587
SMTP_RELAY_USERNAME=
SMTP_RELAY_PASSWORD=
SMTP_RELAY_HOSTNAME=smtp-relay

# ─── Docker build ─────────────────────────────────────────────────────────────
# Установка зависимостей в Docker сейчас обходит проверку TLS: back/Dockerfile
# вызывает uv sync с --allow-insecure-host (pypi.org, files.pythonhosted.org),
# front/Dockerfile задаёт NODE_TLS_REJECT_UNAUTHORIZED=0. Это обход корпоративного
# прокси, а не решение о доверии — задокументировано как известное расхождение
# в docs/ARCHITECTURE.md («Known configuration mismatches»); замена —
# доверенный CA (NODE_EXTRA_CA_CERTS / системное хранилище).
