# Deny-all by default (see root .gitignore): whitelist below.
# .next/, node_modules/, build artifacts, local .env stay out.

*
!/.dockerignore
!/.gitignore
!AGENTS.md
!Dockerfile
!bun.lock
!bunfig.toml
!next.config.ts
!oxfmt.config.ts
!package.json
!playwright.config.ts
!postcss.config.ts
!prek.toml
!tsconfig.json

# Source and static
!/public/
!/public/**
!/src/
!/src/**
!/e2e/
!/e2e/**

# Junk inside the whitelist (last rule wins)
*.tsbuildinfo
.env.local
coverage/
playwright-report/
test-results/
